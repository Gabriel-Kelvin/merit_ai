# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fast fallback on GroqCloud's free developer tier.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional zero-cost fallback. Only openrouter/free or a :free model is accepted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Supabase - the publishable key is safe for the future frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend only. Create/copy a Supabase secret key; never expose it to React.
SUPABASE_SECRET_KEY=

# Use "supabase" for the real app and "memory" only for tests/local fallback.
MERIT_STORAGE_MODE=supabase
MERIT_MAX_QUESTIONS=20
FRONTEND_ORIGIN=http://localhost:5173

# Demo-only authentication. Use a long random session secret.
MERIT_DEMO_USERNAME=demo
MERIT_DEMO_PASSWORD=change-me
MERIT_SESSION_SECRET=replace-with-a-long-random-secret
