# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Supabase - the publishable key is safe for the future frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend only. Create/copy a Supabase secret key; never expose it to React.
SUPABASE_SECRET_KEY=

# Use "supabase" for the real app and "memory" only for tests/local fallback.
MERIT_STORAGE_MODE=supabase
MERIT_MAX_QUESTIONS=7
FRONTEND_ORIGIN=http://localhost:5173
